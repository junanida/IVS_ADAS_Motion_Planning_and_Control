%     end
% 
%     if ~found
%         global_path_xy_dense = zeros(MAXLEN,2); % error 방지
%         return
%     end
% 
%     % --- 경로 추적 (preallocation) ---
%     MAX_PATH_LEN = N;
%     tmp_path = zeros(MAX_PATH_LEN, 1);
%     idx = 1;
%     curr = gIdx;
%     while curr ~= sIdx
%         tmp_path(idx) = curr;
