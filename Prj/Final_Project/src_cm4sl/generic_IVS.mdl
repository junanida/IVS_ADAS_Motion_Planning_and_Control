<?xml version="1.0" encoding="utf-8"?>
<chart id="629">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/MATLAB Function14</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">629</P>
  <P Name="ssIdHighWaterMark">7</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">52</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">currentSegment</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">629</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function Driving_finish_flag = currentSegment(Ego_x, Ego_y, waypoint)

    persistent counter segment triggered   % 상태를 기억하는 persistent 변수 추가

    if isempty(segment)
        segment = 0;  % segment 초기화
    end
    
    if isempty(counter)
        counter = 0;  % counter 초기화
        triggered = false;  % 처음 구간에 진입했는지 여부 확인
    end

    % Ego 차량 위치와 각 waypoint 간의 거리 계산
    distances = sqrt((waypoint(:,1) - Ego_x).^2 + (waypoint(:,2) - Ego_y).^2);
    
    % 가장 가까운 waypoint의 인덱스 찾기
    [~, minIndex] = min(distances);
    
    % 구간 번호를 반환하기
    % 주차장 앞: index 1~10, 240~250, 480~490 범위 중 하나라도 해당되면 주차장 앞
    if (minIndex &gt;= 5 &amp;&amp; minIndex &lt;= 15) || (minIndex &gt;= 246 &amp;&amp; minIndex &lt;= 255) || (minIndex &gt;= 486 &amp;&amp; minIndex &lt;= 495)
        if ~triggered  % 처음으로 구간에 진입한 경우
            triggered = true;  % 구간 진입 처리
        end

        % counter가 200에 도달하면 segment 1을 반환
        if counter &gt;= 200
            segment = 1;  % 주차장 앞
        else
            segment = 0;  % 해당 구간이 아니면 0 반환
        end
    end

    % 구간에 진입한 후부터 counter 증가
    if triggered
        counter = counter + 1;
    end
    Driving_finish_flag= segment;
end
</P>
      </eml>
    </state>
    <data SSID="4" name="Ego_x">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="Driving_finish_flag">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="Ego_y">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="waypoint">
      <P Name="scope">INPUT_DATA</P>
