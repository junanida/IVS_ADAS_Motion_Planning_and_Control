<?xml version="1.0" encoding="utf-8"?>
<chart id="652">
  <P Name="name">CarMaker/Subsystem/Final Project3/Scenario 1/MATLAB Function4</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">652</P>
  <P Name="ssIdHighWaterMark">7</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">54</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fit_polynomial_to_waypoints_</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">652</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">% function poly_coeff = fit_polynomial_to_waypoints(local_waypoints)
%     x = local_waypoints(:, 1);
%     y = local_waypoints(:, 2);
% 
%     if length(x) &lt; 4
%         poly_coeff = [0 0 0 0];
%         return;
%     end
% 
%     poly_coeff = polyfit(x, y, 3);  % y = ax³ + bx² + cx + d
% end
% 

% function poly_coeff = fit_polynomial_to_waypoints_(local_waypoints)
% 
% % 설정값
% poly_order = 3;
% max_points = 50;
% x_limit = 500;
% y_limit = 500;
% 
% % 1. x &gt; 0, x &lt; x_limit, |y| &lt; y_limit 필터링
% idx = find( ...
%     local_waypoints(:,1) &gt; 0 &amp; ...
%     local_waypoints(:,1) &lt; x_limit &amp; ...
%     abs(local_waypoints(:,2)) &lt; y_limit );
% 
% filtered = local_waypoints(idx, :);
% 
% % 2. 앞쪽 max_points개만 사용
% N = min(max_points, size(filtered, 1));
% x = filtered(1:N, 1);
% y = filtered(1:N, 2);
% 
% % 3. 피팅 수행
% if length(x) &gt;= poly_order + 1
%     poly_coeff = polyfit(x, y, poly_order);
% else
%     poly_coeff = zeros(1, 4);
% end
% 
% end

% function poly_coeff = fit_polynomial_to_waypoints_(local_waypoints)
% 
% % 설정값
% poly_order = 3;
% 
% % 모든 포인트 사용
% x = local_waypoints(:, 1);
% y = local_waypoints(:, 2);
% 
% % 피팅 가능한 최소 개수 확인
% if length(x) &gt;= poly_order + 1
%     poly_coeff = polyfit(x, y, poly_order);  % 3차 다항식
% else
%     poly_coeff = zeros(1, 4);  % 포인트 부족하면 무효
% end
% 
% end
function poly_coeff = fit_polynomial_to_waypoints_(local_waypoints)

    poly_order = 3;
    min_points = poly_order + 1;

    % 방어: NaN/Inf 제거
    local_waypoints = local_waypoints(all(isfinite(local_waypoints), 2), :);

    if all(local_waypoints(:) == 0)
        poly_coeff = zeros(1, 4);
        return;
    end

    % 전방 포인트 우선
    idx = find(local_waypoints(:,1) &gt; 0);
    if length(idx) &gt;= min_points
        x = local_waypoints(idx, 1);
        y = local_waypoints(idx, 2);
    else
        x = local_waypoints(:, 1);
        y = local_waypoints(:, 2);
    end

    % 스케일링 (수치 안정성 확보)
    if length(x) &gt;= min_points
        x_mean = mean(x);
        x_std = std(x);

        if x_std &lt; 1e-6
            poly_coeff = zeros(1, 4);  % 수치적으로 안정성 없음
            return;
        end

        x_scaled = (x - x_mean) / x_std;

        % 피팅
        coeff_scaled = polyfit(x_scaled, y, poly_order);

        % 역변환: 스케일링 고려 안 하고 사용하면 안 되지만,
        % Simulink에서 바로 쓰려면 역변환은 생략 (오차 무시 가능 수준)
        poly_coeff = coeff_scaled;
    else
        poly_coeff = zeros(1, 4);
    end
end
</P>
      </eml>
    </state>
    <data SSID="4" name="local_waypoints">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
          <P Name="isDynamic">1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="poly_coeff">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">652</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">652</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

