      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function gate_flag = gate_detect(Ego_x, Ego_y)
    % 박스 좌표 설정 (예: 좌상단 기준)
    x_min = -183;  % ← 좌상단 x
    x_max = -128;  % ← 우하단 x
    y_min = -164;   % ← 좌하단 y
    y_max = -77;   % ← 좌상단 y

    gate_flag = false;
    if (Ego_x &gt;= x_min &amp;&amp; Ego_x &lt;= x_max &amp;&amp; Ego_y &gt;= y_min &amp;&amp; Ego_y &lt;= y_max)
        gate_flag = true;
    else
        gate_flag = false;
    end
end
</P>
      </eml>
    </state>
