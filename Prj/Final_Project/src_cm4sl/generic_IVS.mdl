<?xml version="1.0" encoding="utf-8"?>
<chart id="720">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem1/MATLAB Function6</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">720</P>
  <P Name="ssIdHighWaterMark">24</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">61</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">get_lane_indices_split</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">720</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [ego_lane_idx, traffic_lane_idx] = get_lane_indices_split(ego_pos, traffic_info, wp1, wp2, wp3)
% ego_pos: [1 x 2]
% traffic_info: [8 x 10] → 각 행: [x, y, vx, vy, ax, ay, yaw, yawRate, length, width]
% wp1~3: [N x 2] (차선별 waypoint 좌표)
% ego_lane_idx: 자차 차선 번호 (1~3)
% traffic_lane_idx: [8 x 1] (각 차량의 차선 번호)

    traffic_pos = traffic_info(:, 1:2);  % x, y 추출
    num_traffic = size(traffic_pos, 1);  % 8 expected
    traffic_lane_idx = zeros(num_traffic, 1);

    % 거리 계산 함수
    function d = min_dist(p, wp)
        dx = wp(:,1) - p(1);
        dy = wp(:,2) - p(2);
        d = min(sqrt(dx.^2 + dy.^2));
    end

    % 자차 차선 판단
    d1 = min_dist(ego_pos, wp1);
    d2 = min_dist(ego_pos, wp2);
    d3 = min_dist(ego_pos, wp3);
    [~, ego_lane_idx] = min([d1, d2, d3]);

    % 트래픽 차량들 차선 판단
    for i = 1:num_traffic
        car_pos = traffic_pos(i, :);
        d1 = min_dist(car_pos, wp1);
        d2 = min_dist(car_pos, wp2);
        d3 = min_dist(car_pos, wp3);
        [~, traffic_lane_idx(i)] = min([d1, d2, d3]);
    end
end
</P>
      </eml>
    </state>
    <data SSID="23" name="ego_pos">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="4" name="traffic_info">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="ego_lane_idx">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="wp1">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="wp2">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="22" name="wp3">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
