<?xml version="1.0" encoding="utf-8"?>
<chart id="744">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem1/MATLAB Function11</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">744</P>
  <P Name="ssIdHighWaterMark">28</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">63</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">acc_target_speed_global_based</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">744</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">% function [target_speed, debug_dist] = acc_target_speed_global_based( ...
%     ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
%     traffic_info, traffic_lane_idx)
% 
%     % 기본 설정
%     default_speed = 16.0;   % m/s
%     min_gap = 20;           % 최소 안전 거리
%     max_gap = 35;           % 거리 완충 구간
% 
%     % === traffic_info: [8x10] ===
%     % 컬럼:
%     % 1: x, 2: y, 3: vx, 4: vy, 5: ax, 6: ay, 7: yaw, 8: yawrate, 9: len, 10: width
%     traffic_pos = traffic_info(:, 1:2);  % [8x2]
%     traffic_vx = traffic_info(:, 3);     % [8x1]
% 
%     L = size(traffic_info, 1);  % 차량 수 (8)
% 
%     min_dist = inf;
%     front_vx = 0;
%     found = false;
% 
%     % Ego 진행 방향 단위벡터
%     ego_dir = [cos(ego_yaw); sin(ego_yaw)];
% 
%     for i = 1:L
%         if traffic_lane_idx(i) == ego_lane_idx
%             dx = traffic_pos(i,1) - ego_pos(1);
%             dy = traffic_pos(i,2) - ego_pos(2);
%             rel_vec = [dx; dy];
% 
%             % 전방 차량인지 판단
%             if dot(rel_vec, ego_dir) &gt; 0
%                 dist = norm(rel_vec);
% 
%                 if dist &lt; min_dist
%                     min_dist = dist;
%                     front_vx = traffic_vx(i);
%                     found = true;
%                 end
%             end
%         end
%     end
% 
%     % 속도 설정
%     target_speed = default_speed;
% 
%     if found
%         if min_dist &lt; min_gap
%             target_speed = front_vx;
%         elseif min_dist &lt; max_gap
%             ratio = (min_dist - min_gap) / (max_gap - min_gap);
%             target_speed = front_vx * ratio + default_speed * (1 - ratio);
%         else
%             target_speed = default_speed;
%         end
%     end
% 
%     debug_dist = min_dist;
% end



function [target_speed, debug_dist] = acc_target_speed_global_based( ...
    ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
    traffic_info, traffic_lane_idx)

     
        
     default_speed = 3;

     

    % 기본 설정
    % default_speed = 12.0;   % m/s
    min_gap = 25;           % 최소 안전 거리
    max_gap = 50;           % 거리 완충 구간
    min_speed = 3.0;        % 최저속도(정지 방지)

    % === traffic_info: [8x10] ===
    % 1: x, 2: y, 3: vx, ...
    traffic_pos = traffic_info(:, 1:2);  % [8x2]
    traffic_vx = traffic_info(:, 3);     % [8x1]

    L = size(traffic_info, 1);  % 차량 수 (8)

    min_dist = inf;
    front_vx = 0;
    found = false;

    % Ego 진행 방향 단위벡터
    ego_dir = [cos(ego_yaw); sin(ego_yaw)];

    for i = 1:L
        if traffic_lane_idx(i) == ego_lane_idx
            dx = traffic_pos(i,1) - ego_pos(1);
            dy = traffic_pos(i,2) - ego_pos(2);
            rel_vec = [dx; dy];

            % 전방 차량인지 판단
            if dot(rel_vec, ego_dir) &gt; 0
                dist = norm(rel_vec);

                if dist &lt; min_dist
                    min_dist = dist;
                    front_vx = traffic_vx(i);
                    found = true;
                end
            end
        end
    end

    % 속도 설정
    target_speed = default_speed;

    if found
        % *** 디버깅 로그 출력 (필요시 주석 해제) ***
        % disp([&apos;front_vx=&apos;, num2str(front_vx), &apos;, min_dist=&apos;, num2str(min_dist)]);

        % front_vx가 비정상(음수/NaN/이상치)이거나 너무 작으면 방어!
        if isnan(front_vx) || front_vx &lt; 0
            front_vx = min_speed;
        end

        if min_dist &lt; min_gap
            % 앞차 속도가 0일 때만 내 차도 정지, 그 외엔 최소 속도 유지
            if front_vx &lt;= min_speed
                target_speed = min_speed;
            else
                target_speed = front_vx;
            end
        elseif min_dist &lt; max_gap
            ratio = (min_dist - min_gap) / (max_gap - min_gap);
            % 보간 결과가 너무 작을 경우도 방어
            blend_speed = front_vx * ratio + default_speed * (1 - ratio);
            target_speed = max(blend_speed, min_speed);
        else
            target_speed = default_speed;
        end
    end

    % 추가 방어: target_speed는 항상 min_speed 이상 보장
    target_speed = max(target_speed, min_speed);

    debug_dist = min_dist;
end
</P>
      </eml>
    </state>
    <data SSID="7" name="ego_pos">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
