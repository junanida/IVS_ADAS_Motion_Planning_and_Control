      <eml>
        <P Name="isEML">1</P>
        <P Name="script">% function global_path_xy_dense = make_global_path(waypoints, startIdx, must1, must2, goalIdx)
% %#codegen
% 
% N = size(waypoints,1);
% max_neighbors = 20;
% MAXLEN = 2000; % 충분히 크게
% 
% % --- via_nodes 처리 ---
% via_nodes = startIdx;
% if must1 ~= 0
%     via_nodes = [via_nodes, must1];
% end
% if must2 ~= 0
%     via_nodes = [via_nodes, must2];
% end
% via_nodes = [via_nodes, goalIdx];
% 
% % --- 진행방향 단위 벡터 계산 ---
% forward_vecs = zeros(N,2);
% for i = 1:N-1
%     v = waypoints(i+1,:) - waypoints(i,:);
%     vn = norm(v);
%     if vn &gt; 1e-6
%         forward_vecs(i,:) = v / vn;
%     else
%         forward_vecs(i,:) = [1,0];
%     end
% end
% forward_vecs(N,:) = forward_vecs(N-1,:);
% 
% % --- 이웃 리스트 (고정 double array) ---
% neighborList = zeros(N, max_neighbors);
% neighborNum  = zeros(N,1);
% D_thresh = 5;
% 
% for i = 1:N
%     dists = sqrt(sum((waypoints - waypoints(i,:)).^2, 2));
%     candidateIdx = find(dists &gt; 0 &amp; dists &lt; D_thresh);
% ncnt = 0;
% for j = 1:length(candidateIdx)
%     idx = candidateIdx(j);
%     vec = waypoints(idx,:) - waypoints(i,:);
%     vn2 = norm(vec);
%     if vn2 &lt; 1e-6
%         continue;
%     end
%     vec = vec / vn2;
%     if dot(forward_vecs(i,:), vec) &gt; 0
%         if ncnt &lt; max_neighbors   % &lt;--- 바꿔주세요!
%             ncnt = ncnt+1;
%             neighborList(i,ncnt) = idx;
%         end
%     end
% end
% neighborNum(i) = ncnt;
% end
% 
% % --- 전체 경로 연결 (via_nodes 순서대로, preallocation) ---
% full_path = zeros(N * (length(via_nodes)-1), 1);
% full_idx = 1;
% 
% for seg = 1:(length(via_nodes)-1)
%     sIdx = via_nodes(seg);
%     gIdx = via_nodes(seg+1);
% 
%     cameFrom = zeros(N,1);
%     gScore   = inf(N,1);
%     fScore   = inf(N,1);
% 
%     gScore(sIdx) = 0;
%     fScore(sIdx) = norm(waypoints(sIdx,:) - waypoints(gIdx,:));
%     openSet = zeros(N,1);
%     openSet(1) = sIdx;
%     openLen = 1;
% 
%     found = false;
%     while openLen &gt; 0
%         fvalues = zeros(openLen,1);
%         for i = 1:openLen
%             fvalues(i) = fScore(openSet(i));
%         end
%         [~, minIdx] = min(fvalues);
%         current = openSet(minIdx);
%         if current == gIdx
%             found = true;
%             break;
%         end
%         if minIdx &lt; openLen
%             openSet(minIdx:openLen-1) = openSet(minIdx+1:openLen);
%         end
%         openLen = openLen - 1;
% 
%         for nidx = 1:neighborNum(current)
%             neighbor = neighborList(current, nidx);
%             edge_cost = norm(waypoints(neighbor,:) - waypoints(current,:));
%             tentative_gScore = gScore(current) + edge_cost;
%             if tentative_gScore &lt; gScore(neighbor)
%                 cameFrom(neighbor) = current;
%                 gScore(neighbor)   = tentative_gScore;
%                 fScore(neighbor)   = tentative_gScore + norm(waypoints(neighbor,:) - waypoints(gIdx,:));
%                 isin = false;
%                 for q = 1:openLen
%                     if openSet(q) == neighbor
%                         isin = true;
%                         break;
%                     end
%                 end
%                 if ~isin &amp;&amp; openLen &lt; N
%                     openLen = openLen+1;
%                     openSet(openLen) = neighbor;
%                 end
%             end
%         end
%     end
% 
%     if ~found
%         global_path_xy_dense = zeros(MAXLEN,2); % error 방지
%         return
%     end
% 
%     % --- 경로 추적 (preallocation) ---
%     MAX_PATH_LEN = N;
%     tmp_path = zeros(MAX_PATH_LEN, 1);
%     idx = 1;
%     curr = gIdx;
%     while curr ~= sIdx
%         tmp_path(idx) = curr;
%         curr = cameFrom(curr);
%         idx = idx + 1;
%         if idx &gt; MAX_PATH_LEN
%             break;
%         end
%     end
%     tmp_path(idx) = sIdx;
%     path = tmp_path(idx:-1:1);
% 
%     if seg &gt; 1
%         path = path(2:end);
%     end
% 
%     lenp = length(path);
%     full_path(full_idx : full_idx+lenp-1) = path;
%     full_idx = full_idx + lenp;
% end
% 
% full_path = full_path(1:full_idx-1);
% 
% % --- 경로 좌표 추출 ---
% global_path_xy = waypoints(full_path, :);
% 
% % --- 보간을 통한 촘촘한 경로 생성 ---
% diffs = diff(global_path_xy);
% seg_len = sqrt(sum(diffs.^2, 2));
% s = [0; cumsum(seg_len)];
% ds_interp = 0.5;
% if s(end) &lt; ds_interp
%     interp_xy = global_path_xy;
% else
%     s_interp = (0:ds_interp:s(end))&apos;;
%     x_interp = interp1(s, global_path_xy(:,1), s_interp, &apos;linear&apos;);
%     y_interp = interp1(s, global_path_xy(:,2), s_interp, &apos;linear&apos;);
%     interp_xy = [x_interp, y_interp];
% end
% 
% global_path_xy_dense = zeros(MAXLEN,2);
% real_len = size(interp_xy,1);
% if real_len &gt; MAXLEN
%     real_len = MAXLEN;
% end
% global_path_xy_dense(1:real_len,:) = interp_xy(1:real_len,:);
% end


function global_path_xy_dense = make_global_path_with_fsm_sfunc(waypoints, startIdx, must1, must2, goalIdx)
% Simulink에서 사용할 수 있도록 만든 FSM 기반 global path 생성 함수
% 입력:
%   waypoints [Nx2] double, startIdx/must1/must2/goalIdx/state: double scalar
% 출력:
%   global_path_xy_dense [MAXLEN x 2] double

%#codegen

MAXLEN = 2000;
N = size(waypoints,1);

% Simulink 실행 시마다 state=0에서 &quot;한 번만&quot; 새 경로 생성

global_path_xy_dense = gen_global_path(waypoints, startIdx, must1, must2, goalIdx, N, MAXLEN);

end

% ---- 내부 subfunction ----
function global_path_xy_dense = gen_global_path(waypoints, startIdx, must1, must2, goalIdx, N, MAXLEN)

max_neighbors = 20;
% --- via_nodes 처리 ---
via_nodes = startIdx;
if must1 ~= 0
    via_nodes = [via_nodes, must1];
end
if must2 ~= 0
    via_nodes = [via_nodes, must2];
end
via_nodes = [via_nodes, goalIdx];

% --- 진행방향 단위 벡터 계산 ---
forward_vecs = zeros(N,2);
for i = 1:N-1
    v = waypoints(i+1,:) - waypoints(i,:);
    vn = norm(v);
    if vn &gt; 1e-6
        forward_vecs(i,:) = v / vn;
    else
        forward_vecs(i,:) = [1,0];
    end
end
forward_vecs(N,:) = forward_vecs(N-1,:);

% --- 이웃 리스트 ---
neighborList = zeros(N, max_neighbors);
neighborNum  = zeros(N,1);
D_thresh = 5;

for i = 1:N
    dists = sqrt(sum((waypoints - waypoints(i,:)).^2, 2));
    candidateIdx = find(dists &gt; 0 &amp; dists &lt; D_thresh);
    ncnt = 0;
    for j = 1:length(candidateIdx)
        idx = candidateIdx(j);
        vec = waypoints(idx,:) - waypoints(i,:);
        vn2 = norm(vec);
        if vn2 &lt; 1e-6
            continue;
        end
        vec = vec / vn2;
        if dot(forward_vecs(i,:), vec) &gt; 0
            if ncnt &lt; max_neighbors
                ncnt = ncnt+1;
                neighborList(i,ncnt) = idx;
            end
        end
    end
    neighborNum(i) = ncnt;
end

% --- 전체 경로 연결 (via_nodes 순서대로, preallocation) ---
full_path = zeros(N * (length(via_nodes)-1), 1);
full_idx = 1;

for seg = 1:(length(via_nodes)-1)
    sIdx = via_nodes(seg);
    gIdx = via_nodes(seg+1);

    cameFrom = zeros(N,1);
    gScore   = inf(N,1);
    fScore   = inf(N,1);

    gScore(sIdx) = 0;
    fScore(sIdx) = norm(waypoints(sIdx,:) - waypoints(gIdx,:));
    openSet = zeros(N,1);
    openSet(1) = sIdx;
    openLen = 1;

    found = false;
    while openLen &gt; 0
        fvalues = zeros(openLen,1);
        for i = 1:openLen
            fvalues(i) = fScore(openSet(i));
        end
        [~, minIdx] = min(fvalues);
        current = openSet(minIdx);
        if current == gIdx
            found = true;
            break;
        end
        if minIdx &lt; openLen
            openSet(minIdx:openLen-1) = openSet(minIdx+1:openLen);
        end
        openLen = openLen - 1;

        for nidx = 1:neighborNum(current)
            neighbor = neighborList(current, nidx);
            edge_cost = norm(waypoints(neighbor,:) - waypoints(current,:));
            tentative_gScore = gScore(current) + edge_cost;
            if tentative_gScore &lt; gScore(neighbor)
                cameFrom(neighbor) = current;
                gScore(neighbor)   = tentative_gScore;
                fScore(neighbor)   = tentative_gScore + norm(waypoints(neighbor,:) - waypoints(gIdx,:));
                isin = false;
                for q = 1:openLen
                    if openSet(q) == neighbor
                        isin = true;
                        break;
                    end
                end
                if ~isin &amp;&amp; openLen &lt; N
                    openLen = openLen+1;
                    openSet(openLen) = neighbor;
                end
            end
        end
    end

    if ~found
        global_path_xy_dense = zeros(MAXLEN,2); % error 방지
        return
    end

    % --- 경로 추적 (preallocation) ---
    MAX_PATH_LEN = N;
    tmp_path = zeros(MAX_PATH_LEN, 1);
    idx = 1;
    curr = gIdx;
    while curr ~= sIdx
        tmp_path(idx) = curr;
        curr = cameFrom(curr);
        idx = idx + 1;
        if idx &gt; MAX_PATH_LEN
            break;
        end
    end
    tmp_path(idx) = sIdx;
    path = tmp_path(idx:-1:1);

    if seg &gt; 1
        path = path(2:end);
    end

    lenp = length(path);
    full_path(full_idx : full_idx+lenp-1) = path;
    full_idx = full_idx + lenp;
end

full_path = full_path(1:full_idx-1);

% --- 경로 좌표 추출 ---
global_path_xy = waypoints(full_path, :);

% --- 보간을 통한 촘촘한 경로 생성 ---
diffs = diff(global_path_xy);
seg_len = sqrt(sum(diffs.^2, 2));
s = [0; cumsum(seg_len)];
ds_interp = 0.5;
if s(end) &lt; ds_interp
    interp_xy = global_path_xy;
else
    s_interp = (0:ds_interp:s(end))&apos;;
    x_interp = interp1(s, global_path_xy(:,1), s_interp, &apos;linear&apos;);
    y_interp = interp1(s, global_path_xy(:,2), s_interp, &apos;linear&apos;);
    interp_xy = [x_interp, y_interp];
end

global_path_xy_dense = zeros(MAXLEN,2);
real_len = size(interp_xy,1);
if real_len &gt; MAXLEN
    real_len = MAXLEN;
end
global_path_xy_dense(1:real_len,:) = interp_xy(1:real_len,:);
end
</P>
      </eml>
    </state>
    <data SSID="4" name="waypoints">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
