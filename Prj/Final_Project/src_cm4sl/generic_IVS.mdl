<?xml version="1.0" encoding="utf-8"?>
<chart id="105">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/MATLAB Function11</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">105</P>
  <P Name="ssIdHighWaterMark">28</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">acc_timegap_based</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">105</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [target_speed, debug_time_gap] = acc_timegap_based( ...
    ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
    traffic_info, traffic_lane_idx, gate_flag)

    % 기본 설정
    default_speed = 15.0;      % m/s (기본 크루즈 속도)
    safe_gap_time = 2.5;       % 안전 시간 간격 (초)
    emergency_gap_time = 1.8;  % 비상 시간 간격 (초)

    % 이전 속도 유지용 변수
    persistent last_speed
    if isempty(last_speed)
        last_speed = default_speed;
    end

    % 전방 차량 정보 분리
    traffic_pos = traffic_info(:, 1:2);   % 위치 [8x2]
    traffic_vx = traffic_info(:, 3);      % 속도 [8x1]
    L = size(traffic_info, 1);            % 차량 수

    % 초기값 설정
    min_gap_time = inf;
    front_vx = 0;
    found = false;

    ego_dir = [cos(ego_yaw); sin(ego_yaw)];  % 주행 방향 단위 벡터

    for i = 1:L
        if traffic_lane_idx(i) == ego_lane_idx
            dx = traffic_pos(i,1) - ego_pos(1);
            dy = traffic_pos(i,2) - ego_pos(2);
            rel_vec = [dx; dy];

            if dot(rel_vec, ego_dir) &gt; 0  % 전방 차량인지 확인
                dist = norm(rel_vec);

                % ego 속도가 0이면 분모 0 방지
                if ego_vx &gt; 0
                    time_gap = dist / ego_vx;
                else
                    time_gap = inf;
                end

                if time_gap &lt; min_gap_time
                    min_gap_time = time_gap;
                    front_vx = traffic_vx(i);
                    found = true;
                end
            end
        end
    end

    % 기본 속도 계산 (gate_flag 고려 없이)
    speed = default_speed;
    if found
        if min_gap_time &lt; emergency_gap_time
            speed = 0;  % 매우 위험 → 정지
        elseif min_gap_time &lt; safe_gap_time
            ratio = (min_gap_time - emergency_gap_time) / (safe_gap_time - emergency_gap_time);
            speed = front_vx * ratio;
        end
    end

    % gate_flag에 따라 속도 조정
    if gate_flag
        last_speed = speed * 0.5;  % 속도 절반으로 줄이기
    else
        last_speed = speed;        % 원래 속도 복구
    end

    target_speed = last_speed;

    % 디버깅 정보 출력용
    debug_time_gap = min_gap_time;

%% 
%% 


    persistent prev_x
    if isempty(prev_x)
        prev_x = ego_pos(1);
    end

    x_min = -160;
    x_max = 30;
    v_zone = 30;

    curr_x = ego_pos(1);

    % x증가방향 및 구간내 판정
    if curr_x &gt;= x_min &amp;&amp; curr_x &lt;= x_max &amp;&amp; (curr_x - prev_x) &gt; 0
        target_speed = v_zone;
    % else
        % v_target = nan;   % 구간밖 or 반대방향: 무시
    end

    prev_x = curr_x;    % 이전값 업데이트
end


% function [target_speed, debug_time_gap] = acc_timegap_based( ...
%     ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
%     traffic_info, traffic_lane_idx, gate_flag)
% 
% 
%     % 기본 설정
%     default_speed = 15.0;      % m/s (기본 크루즈 속도)
%     safe_gap_time = 2.5;       % 안전 시간 간격 (초)
%     emergency_gap_time = 1.8;  % 비상 시간 간격 (초)
% 
%     % 전방 차량 정보 분리
%     traffic_pos = traffic_info(:, 1:2);   % 위치 [8x2]
%     traffic_vx = traffic_info(:, 3);      % 속도 [8x1]
%     L = size(traffic_info, 1);            % 차량 수
% 
%     % 초기값 설정
%     min_gap_time = inf;
%     front_vx = 0;
%     found = false;
% 
%     ego_dir = [cos(ego_yaw); sin(ego_yaw)];  % 주행 방향 단위 벡터
% 
%     for i = 1:L
%         if traffic_lane_idx(i) == ego_lane_idx
%             dx = traffic_pos(i,1) - ego_pos(1);
%             dy = traffic_pos(i,2) - ego_pos(2);
%             rel_vec = [dx; dy];
% 
%             if dot(rel_vec, ego_dir) &gt; 0  % 전방 차량인지 확인
%                 dist = norm(rel_vec);
% 
%                 % ego 속도가 0이면 분모 0 방지
%                 if ego_vx &gt; 0
%                     time_gap = dist / ego_vx;
%                 else
%                     time_gap = inf;
%                 end
% 
%                 if time_gap &lt; min_gap_time
%                     min_gap_time = time_gap;
%                     front_vx = traffic_vx(i);
%                     found = true;
%                 end
%             end
%         end
%     end
% 
%     % 속도 결정 로직
%     target_speed = default_speed;
% 
%     if found
%         if min_gap_time &lt; emergency_gap_time
%             target_speed = 0;  % 매우 위험 → 정지
%         elseif min_gap_time &lt; safe_gap_time
%             ratio = (min_gap_time - emergency_gap_time) / (safe_gap_time - emergency_gap_time);
%             target_speed = front_vx * ratio;
%         else
%             target_speed = default_speed;
%         end
%     end
% 
%     if gate_flag ==1
% 
%     % 디버깅 정보 출력용
%     debug_time_gap = min_gap_time;
% end
% 
% 
</P>
      </eml>
    </state>
    <data SSID="7" name="ego_pos">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="ego_yaw">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="26" name="ego_vx">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="22" name="ego_lane_idx">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="23" name="traffic_info">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="target_speed">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="25" name="traffic_lane_idx">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="27" name="debug_time_gap">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="28" name="gate_flag">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
