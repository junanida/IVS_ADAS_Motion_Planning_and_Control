<?xml version="1.0" encoding="utf-8"?>
<chart id="795">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem1/MATLAB Function8</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">795</P>
  <P Name="ssIdHighWaterMark">23</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">68</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">compute_lateral_error_</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">795</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [lateral_error, x_lookahead, delta_ff, dy, d2y, kappa] = compute_lateral_error_(poly_coeff, velocity, lookahead_time)
% ------------------------------------------------------------
% 경로 다항식 기반 곡률 및 조향각 계산 (스무딩 포함)
% Waypoint 부족 시 조향각 0 처리
% ------------------------------------------------------------

% 휠베이스
L = 3.0;

% Waypoint 부족으로 poly_coeff가 모두 0일 경우 → 계산 중단
if all(poly_coeff == 0)
    lateral_error = 0;
    x_lookahead = velocity * lookahead_time;
    delta_ff = 0;
    dy = 0;
    d2y = 0;
    kappa = 0;
    return;
end

% 다항식 계수 추출
a = 0; b = 0; c = 0; d = 0;
n = length(poly_coeff);
if n == 4
    a = poly_coeff(1); b = poly_coeff(2); c = poly_coeff(3); d = poly_coeff(4);
elseif n == 3
    b = poly_coeff(1); c = poly_coeff(2); d = poly_coeff(3);
elseif n == 2
    c = poly_coeff(1); d = poly_coeff(2);
else
    d = poly_coeff(1);
end

% 1. lateral error (x = 0)
lateral_error = d;

% 2. lookahead 위치
x_lookahead = velocity * lookahead_time;

% 3. dy, d2y
dy = 3*a*x_lookahead^2 + 2*b*x_lookahead + c;
d2y = 6*a*x_lookahead + 2*b;

% 4. kappa 계산 (수치 안정성 보장)
denominator = (1 + dy^2)^(3/2);
if denominator &lt; 1e-6
    denominator = 1e-6;
end
kappa = d2y / denominator;

% 5. 조향각 계산
delta_now = L * kappa;

% 6. Moving Average Filter 적용 (스무딩)
persistent delta_buffer
if isempty(delta_buffer)
    delta_buffer = zeros(1, 30);  % 최근 30개 저장
end

% shift + 최신값 추가
delta_buffer = [delta_now, delta_buffer(1:end-1)];

% 평균값 출력
delta_ff = mean(delta_buffer);

end


 </P>
      </eml>
    </state>
    <data SSID="4" name="poly_coeff">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="lateral_error">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="velocity">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="lookahead_time">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="17" name="x_lookahead">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="18" name="delta_ff">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
