        <P Name="isEML">1</P>
        <P Name="script">% function [lateral_error, x_lookahead, delta_ff, dy, d2y, kappa] = compute_lateral_error_(poly_coeff, velocity, lookahead_time)
% % ------------------------------------------------------------
% % 경로 다항식 기반 곡률 및 조향각 계산 (스무딩 포함)
% % Waypoint 부족 시 조향각 0 처리
% % ------------------------------------------------------------
% 
% % 휠베이스
% L = 2.9;
% 
% % Waypoint 부족으로 poly_coeff가 모두 0일 경우 → 계산 중단
% if all(poly_coeff == 0)
%     lateral_error = 0;
%     x_lookahead = velocity * lookahead_time;
%     delta_ff = 0;
%     dy = 0;
%     d2y = 0;
%     kappa = 0;
%     return;
% end
% 
% % 다항식 계수 추출
% a = 0; b = 0; c = 0; d = 0;
% n = length(poly_coeff);
% if n == 4
%     a = poly_coeff(1); b = poly_coeff(2); c = poly_coeff(3); d = poly_coeff(4);
% elseif n == 3
%     b = poly_coeff(1); c = poly_coeff(2); d = poly_coeff(3);
% elseif n == 2
%     c = poly_coeff(1); d = poly_coeff(2);
% else
%     d = poly_coeff(1);
% end
% 
% % 1. lateral error (x = 0)
% lateral_error = d;
% 
% % 2. lookahead 위치
% x_lookahead = velocity * lookahead_time;
% 
% % 3. dy, d2y
% dy = 3*a*x_lookahead^2 + 2*b*x_lookahead + c;
% d2y = 6*a*x_lookahead + 2*b;
% 
% % 4. kappa 계산 (수치 안정성 보장)
% denominator = (1 + dy^2)^(3/2);
% if denominator &lt; 1e-6
%     denominator = 1e-6;
% end
% kappa = d2y / denominator;
% 
% % 5. 조향각 계산
% delta_now = L * kappa;
% 
% % 6. Moving Average Filter 적용 (스무딩)
% persistent delta_buffer
% if isempty(delta_buffer)
%     delta_buffer = zeros(1, 30);  % 최근 30개 저장
% end
% 
% % shift + 최신값 추가
% delta_buffer = [delta_now, delta_buffer(1:end-1)];
% 
% % 평균값 출력
% delta_ff = mean(delta_buffer);
% 
% end

%%

function [lateral_error, x_lookahead, delta_ff, dy, d2y, kappa] = compute_lateral_error_(poly_coeff, velocity, lookahead_time)
% ------------------------------------------------------------
% 경로 다항식 기반 곡률 및 조향각 계산 (필터 제거 버전)
% ------------------------------------------------------------

% 휠베이스
L = 2.9;

% 웨이포인트가 없으면 무효 처리
if all(poly_coeff == 0)
    lateral_error = 0;
    x_lookahead = velocity * lookahead_time;
    delta_ff = 0;
    dy = 0;
    d2y = 0;
    kappa = 0;
    return;
end

% 다항식 계수 추출
a = 0; b = 0; c = 0; d = 0;
n = length(poly_coeff);
if n == 4
    a = poly_coeff(1); b = poly_coeff(2); c = poly_coeff(3); d = poly_coeff(4);
elseif n == 3
    b = poly_coeff(1); c = poly_coeff(2); d = poly_coeff(3);
elseif n == 2
    c = poly_coeff(1); d = poly_coeff(2);
else
    d = poly_coeff(1);
end

% 1. lateral error (x = 0 기준)
lateral_error = d;

% 2. lookahead 위치
x_lookahead = velocity * lookahead_time;

% 3. 경사도 및 곡률 미분값 계산
dy = 3*a*x_lookahead^2 + 2*b*x_lookahead + c;
d2y = 6*a*x_lookahead + 2*b;

% 4. 곡률 계산
denominator = (1 + dy^2)^(3/2);
if denominator &lt; 1e-6
    denominator = 1e-6;
end
kappa = d2y / denominator;

% 5. 조향각 = 휠베이스 × 곡률
delta_now = L * kappa;

% 6. 필터 제거 → 바로 적용
delta_ff = delta_now;

end

%%
</P>
