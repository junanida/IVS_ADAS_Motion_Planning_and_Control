<?xml version="1.0" encoding="utf-8"?>
<chart id="443">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem1/MATLAB Function4 1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">443</P>
  <P Name="ssIdHighWaterMark">19</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">35</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fsmPathSelectorGlobal</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">443</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">% function flag  = fsmPathSelectorGlobal( ...
%     global_waypoints, ...
%     x_ego, y_ego)
% %#codegen
% 
% % 상태 정의
% TRACK_MODE = int32(0);
% PARKING_MODE = int32(1);
% REAL_PARKING_MODE = int32(2);
% 
% 
% % 전이 판단용 글로벌 웨이포인트 인덱스 (예: 출발점 근처)
% TRIGGER_IDX = 440;  % 예시: global_waypoints(10,:) 기준
% DIST_THRESHOLD = 1;  % [m]
% 
% % 내부 상태
% persistent fsm_state;
% if isempty(fsm_state)
%     fsm_state = TRACK_MODE;
% end
% 
% % 트리거 포인트 좌표
% trigger_x = global_waypoints(TRIGGER_IDX, 1);
% trigger_y = global_waypoints(TRIGGER_IDX, 2);
% 
% % 현재 위치와 트리거 지점 사이 거리 계산
% dx = trigger_x - x_ego;
% dy = trigger_y - y_ego;
% dist_to_trigger = sqrt(dx^2 + dy^2);
% 
% % FSM 전이 조건
% if fsm_state == TRACK_MODE
%     if dist_to_trigger &lt; DIST_THRESHOLD
%         fsm_state = PARKING_MODE;
%     end
% end
% if fsm_state == PARKING_MODE
%     if x_ego &gt;= 6.0 &amp;&amp; y_ego &lt;= -36.0
%         fsm_state = REAL_PARKING_MODE;
%     end
% end
% 
% % 출력 경로 선택
% if fsm_state == TRACK_MODE
%     flag = 1;
%     %goalIdx = 1382;
% elseif fsm_state == PARKING_MODE
%     flag = 0;
%     %disp(&apos;now we are going to parking lot.&apos;)
%     %goalIdx = 1565;
% else
%     flag = 2;
% end


function G2P  = fsmPathSelectorGlobal( ...
    global_waypoints_in, ...
    x_ego, y_ego, TRIGGER_IDX)
%#codegen

persistent global_waypoints
G2P = 0;

% 전이 판단용 글로벌 웨이포인트 인덱스 (예: 출발점 근처)
  % 예시: global_waypoints(10,:) 기준
DIST_THRESHOLD = 0.2;  % [m]


% global_waypoints를 한 번만 저장
if isempty(global_waypoints)
    global_waypoints = global_waypoints_in;
end




% 트리거 포인트 좌표
trigger_x = global_waypoints(TRIGGER_IDX, 1);
trigger_y = global_waypoints(TRIGGER_IDX, 2);

% 현재 위치와 트리거 지점 사이 거리 계산
dx = trigger_x - x_ego;
dy = trigger_y - y_ego;
dist_to_trigger = sqrt(dx^2 + dy^2);


%disp(dist_to_trigger)

% FSM 전이 조건
if dist_to_trigger &lt; DIST_THRESHOLD
    %disp(&quot;mode change !!&quot;);
    G2P = 1;
end

% if fsm_state == PARKING_MODE
%     if x_ego &gt;= 6.0 &amp;&amp; y_ego &lt;= -36.0
%         fsm_state = REAL_PARKING_MODE;
%     end
% end

</P>
      </eml>
    </state>
    <data SSID="10" name="global_waypoints_in">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="14" name="G2P">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="15" name="x_ego">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="16" name="y_ego">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="19" name="TRIGGER_IDX">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[28.125 13.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">443</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">443</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

