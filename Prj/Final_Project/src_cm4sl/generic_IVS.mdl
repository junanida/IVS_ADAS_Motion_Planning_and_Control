  <eml>
    <P Name="name">and_logic_latch_speed</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">432</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [target_speed_out, finish_flag] = and_logic_latch_speed(u1, u2, u3, target_speed_in)
%#codegen
persistent latch counter finish_flag_persistent

if isempty(latch)
    latch = 0;
    counter = 0;
end
if isempty(finish_flag_persistent)
    finish_flag_persistent = 0;  % 딱 한 번만 0
end

% 정지 조건에 한 번이라도 들어가면 latch=1이 되고, 이후엔 절대 복귀하지 않음
if (u1 &gt; 6) &amp;&amp; (u1 &lt; 8) &amp;&amp; (u2 &gt; -38) &amp;&amp; (u2 &lt; -36)
    latch = 1;
end

if latch == 1
    target_speed_out = 0;
    counter = counter + 1;
    if counter == 50
        finish_flag_persistent = 1;  % 50번째에서 1로 변환, 그 뒤론 계속 1
        disp(u1);
        disp(u2);
        disp(u3);
    end
else
    target_speed_out = target_speed_in;
end

finish_flag = finish_flag_persistent;

end
</P>
      </eml>
    </state>
    <data SSID="4" name="u1">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
