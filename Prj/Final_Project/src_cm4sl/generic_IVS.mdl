  <eml>
    <P Name="name">fsm</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">619</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [en_Driving, en_Go2Park, en_Parking] = fsm(Driving_finish_flag, Go2Park_finish_flag)
    % 초기 상태
    en_Driving = 1;  
    en_Go2Park = 0;  
    en_Parking = 0;  

    % segment가 1일 때 en_Driving만 활성화
    if Driving_finish_flag == 1
        en_Driving = 0;  % Driving 상태 활성화
        en_Go2Park = 1;
        en_Parking = 0; 
    end
    
    if Go2Park_finish_flag == 1
        en_Driving = 0;       
        en_Go2Park = 0;
        en_Parking = 1;  % Go to Park 상태 활성화
    end
end
</P>
      </eml>
    </state>
