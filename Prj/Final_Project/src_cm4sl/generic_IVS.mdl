<?xml version="1.0" encoding="utf-8"?>
<chart id="853">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem/MATLAB Function4 1</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">853</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">10</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">74</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">global_to_local_waypoints</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">853</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">
% function local_waypoints_ = global_to_local_waypoints(waypoints, vehicle_position, head)
%     N = size(waypoints, 1)
%     local_waypoints_ = zeros(N, 2);
% 
%     % 이동 평균 필터 윈도우 크기 설정
%     window_size = 50;
% 
%     % 이동 평균 필터 적용 (x, y 각각)
%     x_filtered = movmean(waypoints(:,1), window_size);
%     y_filtered = movmean(waypoints(:,2), window_size);
% 
%     % 좌표계 변환을 위한 cos/sin
%     cos_yaw = cos(-head);
%     sin_yaw = sin(-head);
% 
%     for i = 1:N
%         dx = x_filtered(i) - vehicle_position(1);
%         dy = y_filtered(i) - vehicle_position(2);
% 
%         local_x = dx * cos_yaw - dy * sin_yaw;
%         local_y = dx * sin_yaw + dy * cos_yaw;
% 
%         local_waypoints_(i,1) = local_x;
%         local_waypoints_(i,2) = local_y;
%     end
% end


% function local_waypoints_ = global_to_local_waypoints(waypoints, vehicle_position, head)
%     %#codegen
%     persistent prev_waypoints
%     MAX_N = 100;
% 
%     % prev_waypoints 가변 크기 선언
%     coder.varsize(&apos;prev_waypoints&apos;, [MAX_N, 2]);
%     coder.varsize(&apos;local_waypoints_&apos;, [MAX_N, 2]);
% 
%     % 초기화
%     if isempty(prev_waypoints)
%         prev_waypoints = zeros(1, 2);  % 크기만 지정, 이후 업데이트
%     end
% 
%     % 입력이 유효하지 않을 때 이전 경로 사용
%     if isempty(waypoints) || size(waypoints,1) &lt; 2 || all(waypoints(:) == 0)
%         waypoints = prev_waypoints;
%     else
%         prev_waypoints = waypoints;
%     end
% 
%     % 좌표 변환 처리
%     N = size(waypoints, 1);
%     N = min(N, MAX_N);  % 방어
% 
%     local_waypoints_ = zeros(N, 2);
% 
%     window_size = min(10, N);
%     x_filtered = movmean(waypoints(:,1), window_size);
%     y_filtered = movmean(waypoints(:,2), window_size);
% 
%     cos_yaw = cos(-head);
%     sin_yaw = sin(-head);
% 
%     for i = 1:N
%         dx = x_filtered(i) - vehicle_position(1);
%         dy = y_filtered(i) - vehicle_position(2);
% 
%         local_x = dx * cos_yaw - dy * sin_yaw;
%         local_y = dx * sin_yaw + dy * cos_yaw;
% 
%         local_waypoints_(i,1) = local_x;
%         local_waypoints_(i,2) = local_y;
%     end
% end

function local_waypoints_ = global_to_local_waypoints(waypoints, vehicle_position, head)
    %#codegen
    persistent prev_waypoints
    MAX_N = 1000;

    % 가변 크기 선언
    coder.varsize(&apos;prev_waypoints&apos;, [MAX_N, 2]);
    coder.varsize(&apos;local_waypoints_&apos;, [MAX_N, 2]);

    % 초기화
    if isempty(prev_waypoints)
        prev_waypoints = zeros(MAX_N, 2);
    end

    % 유효성 검사
    if isempty(waypoints) || size(waypoints,1) &lt; 2 || all(waypoints(:) == 0)
        waypoints = prev_waypoints;
    else
        prev_waypoints = waypoints;
    end

    % 길이 확인
    N = size(waypoints, 1);
    N = min(N, MAX_N);

    local_waypoints_ = zeros(N, 2);

    % 🔧 이동 평균 필터 OFF
    x_data = waypoints(:,1);
    y_data = waypoints(:,2);

    % 좌표 변환
    cos_yaw = cos(-head);
    sin_yaw = sin(-head);

    for i = 1:N
        dx = x_data(i) - vehicle_position(1);
        dy = y_data(i) - vehicle_position(2);

        local_x = dx * cos_yaw - dy * sin_yaw;
        local_y = dx * sin_yaw + dy * cos_yaw;

        local_waypoints_(i,1) = local_x;
        local_waypoints_(i,2) = local_y;
    end
end
</P>
      </eml>
    </state>
    <data SSID="10" name="waypoints">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
