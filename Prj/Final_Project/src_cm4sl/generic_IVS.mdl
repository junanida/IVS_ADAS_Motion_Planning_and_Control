<?xml version="1.0" encoding="utf-8"?>
<chart id="707">
  <P Name="name">CarMaker/Subsystem/Final Project1/Scenario 1/Enabled
Subsystem1/MATLAB Function5</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">707</P>
  <P Name="visible">1</P>
  <subviewS/>
  <P Name="ssIdHighWaterMark">27</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">0.05</P>
  <P Name="chartFileNumber">60</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">acc_timegap_based</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">707</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">% function [target_speed, debug_ttc] = acc_ttc_based( ...
%     ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
%     traffic_info, traffic_lane_idx)
% 
%     default_speed = 10.0;     % m/s
%     safe_ttc = 2;          % TTC 임계값 (초)
%     emergency_ttc = 1;     % 급감속 기준 TTC
% 
%     traffic_pos = traffic_info(:, 1:2);   % [8x2]
%     traffic_vx = traffic_info(:, 3);      % [8x1]
% 
%     L = size(traffic_info, 1);
% 
%     min_ttc = inf;
%     front_vx = 0;
%     found = false;
% 
%     ego_dir = [cos(ego_yaw); sin(ego_yaw)];
% 
%     for i = 1:L
%         if traffic_lane_idx(i) == ego_lane_idx
%             dx = traffic_pos(i,1) - ego_pos(1);
%             dy = traffic_pos(i,2) - ego_pos(2);
%             rel_vec = [dx; dy];
% 
%             if dot(rel_vec, ego_dir) &gt; 0
%                 dist = norm(rel_vec);
%                 rel_v = ego_vx - traffic_vx(i);  % 상대 속도
% 
%                 if rel_v &gt; 0
%                     ttc = dist / rel_v;
%                     if ttc &lt; min_ttc
%                         min_ttc = ttc;
%                         front_vx = traffic_vx(i);
%                         found = true;
%                     end
%                 end
%             end
%         end
%     end
% 
%     % 속도 결정
%     target_speed = default_speed;
% 
%     if found
%         if min_ttc &lt; emergency_ttc
%             target_speed = 0;  % 매우 위험 → 정지
%         elseif min_ttc &lt; safe_ttc
%             % 비례 감속
%             ratio = (min_ttc - emergency_ttc) / (safe_ttc - emergency_ttc);
%             target_speed = front_vx * ratio;
%         else
%             target_speed = default_speed;
%         end
%     end
% 
%     debug_ttc = min_ttc;
% end
function [target_speed, debug_time_gap] = acc_timegap_based( ...
    ego_pos, ego_yaw, ego_vx, ego_lane_idx, ...
    traffic_info, traffic_lane_idx)

    % 기본 설정
    default_speed = 3;      % m/s (기본 크루즈 속도)
    safe_gap_time = 3.0;       % 안전 시간 간격 (초)
    emergency_gap_time = 2.0;  % 비상 시간 간격 (초)

    % 전방 차량 정보 분리
    traffic_pos = traffic_info(:, 1:2);   % 위치 [8x2]
    traffic_vx = traffic_info(:, 3);      % 속도 [8x1]
    L = size(traffic_info, 1);            % 차량 수

    % 초기값 설정
    min_gap_time = inf;
    front_vx = 0;
    found = false;

    ego_dir = [cos(ego_yaw); sin(ego_yaw)];  % 주행 방향 단위 벡터

    for i = 1:L
        if traffic_lane_idx(i) == ego_lane_idx
            dx = traffic_pos(i,1) - ego_pos(1);
            dy = traffic_pos(i,2) - ego_pos(2);
            rel_vec = [dx; dy];

            if dot(rel_vec, ego_dir) &gt; 0  % 전방 차량인지 확인
                dist = norm(rel_vec);

                % ego 속도가 0이면 분모 0 방지
                if ego_vx &gt; 0
                    time_gap = dist / ego_vx;
                else
                    time_gap = inf;
                end

                if time_gap &lt; min_gap_time
                    min_gap_time = time_gap;
                    front_vx = traffic_vx(i);
                    found = true;
                end
            end
        end
    end

    % 속도 결정 로직
    target_speed = default_speed;

    if found
        if min_gap_time &lt; emergency_gap_time
            target_speed = 0;  % 매우 위험 → 정지
        elseif min_gap_time &lt; safe_gap_time
            ratio = (min_gap_time - emergency_gap_time) / (safe_gap_time - emergency_gap_time);
            target_speed = front_vx * ratio;
        else
            target_speed = default_speed;
        end
    end

    % 디버깅 정보 출력용
    debug_time_gap = min_gap_time;
end


</P>
      </eml>
    </state>
    <data SSID="7" name="ego_pos">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
